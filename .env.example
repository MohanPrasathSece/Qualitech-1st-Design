# Supabase Backend Configuration for Qualitech Connectronics
# Replace with your project credentials from https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Storage Buckets
VITE_SUPABASE_BUCKET_PRODUCTS=product-images
VITE_SUPABASE_BUCKET_DOCS=cad-drawings
VITE_SUPABASE_BUCKET_INVOICES=invoices

# SMTP / Email Configuration (Gmail App Password)
VITE_ADMIN_NOTIFICATION_EMAIL=info@qualitechindia.in
VITE_SMTP_USER=zyradigitalsofficial@gmail.com
VITE_SMTP_PASS=your-gmail-app-password
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=465
VITE_SMTP_SECURE=true
VITE_SMTP_ENDPOINT=/api/send-email

# Razorpay Payment Gateway Configuration (Get from https://dashboard.razorpay.com/app/keys)
# Frontend Public Key ID (starts with rzp_test_ or rzp_live_)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Backend Serverless Credentials for Order Creation & HMAC Signature Verification
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional Webhook Secret (Configured under Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
